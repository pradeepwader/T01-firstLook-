# ---------- App ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Public https URL of this API (needed only for Cashfree webhooks, e.g. an ngrok URL)
SERVER_PUBLIC_URL=

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/t01

# ---------- Auth ----------
# Generate: node -e "console.log(require(\"crypto\").randomBytes(48).toString(\"hex\"))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# ---------- Payments ----------
# mock      = local testing without Cashfree keys (blocked in production)
# cashfree  = real Cashfree Payment Gateway
PAYMENT_MODE=mock
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01

# ---------- Email (optional; emails are printed to the console when empty) ----------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="T01 <no-reply@t01.example>"

# ---------- First admin account (used by `npm run seed`) ----------
ADMIN_NAME=T01 Admin
ADMIN_EMAIL=admin@t01.local
ADMIN_PASSWORD=ChangeMe@123
ADMIN_PHONE=9999999999
